<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="task" method="upgrade">
	<name>plg_task_translationslanguagefiles</name>
	<creationDate>2026-10</creationDate>
	<author>Joomla! Project</author>
	<authorUrl>https://github.com/joomla-projects/gsoc26_translator_feedback</authorUrl>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>1.1.0</version>
	<description>PLG_TASK_TRANSLATIONSLANGUAGEFILES_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\Task\TranslationsLanguageFiles</namespace>
	<files>
		<folder plugin="translationslanguagefiles">services</folder>
		<folder>src</folder>
		<folder>forms</folder>
		<folder>sql</folder>
	</files>
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<languages>
		<language tag="en-GB">language/en-GB/plg_task_translationslanguagefiles.ini</language>
		<language tag="en-GB">language/en-GB/plg_task_translationslanguagefiles.sys.ini</language>
	</languages>
	<!-- This plugin is a download of its own, so it is offered updates of its own. The file is
	     generated by build/update-xml.php; a site remembers this URL, so it is not moved. -->
	<updateservers>
		<server type="extension" name="Translator Feedback language files" priority="1">https://raw.githubusercontent.com/joomla-projects/gsoc26_translator_feedback/main/updates/plg_task_translationslanguagefiles.xml</server>
	</updateservers>
</extension>
