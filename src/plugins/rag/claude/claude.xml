<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="rag" method="upgrade">
	<name>plg_rag_claude</name>
	<creationDate>2026-07</creationDate>
	<author>Joomla! Project</author>
	<authorUrl>https://github.com/joomla-projects/gsoc26_translator_feedback</authorUrl>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>1.2.1</version>
	<description>PLG_RAG_CLAUDE_XML_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\Rag\Claude</namespace>
	<files>
		<folder plugin="claude">services</folder>
		<folder>src</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_rag_claude.ini</language>
		<language tag="en-GB">language/en-GB/plg_rag_claude.sys.ini</language>
		<language tag="de-DE">language/de-DE/plg_rag_claude.ini</language>
		<language tag="de-DE">language/de-DE/plg_rag_claude.sys.ini</language>
		<language tag="es-ES">language/es-ES/plg_rag_claude.ini</language>
		<language tag="es-ES">language/es-ES/plg_rag_claude.sys.ini</language>
		<language tag="fa-IR">language/fa-IR/plg_rag_claude.ini</language>
		<language tag="fa-IR">language/fa-IR/plg_rag_claude.sys.ini</language>
		<language tag="fr-FR">language/fr-FR/plg_rag_claude.ini</language>
		<language tag="fr-FR">language/fr-FR/plg_rag_claude.sys.ini</language>
		<language tag="it-IT">language/it-IT/plg_rag_claude.ini</language>
		<language tag="it-IT">language/it-IT/plg_rag_claude.sys.ini</language>
		<language tag="nl-NL">language/nl-NL/plg_rag_claude.ini</language>
		<language tag="nl-NL">language/nl-NL/plg_rag_claude.sys.ini</language>
		<language tag="pt-BR">language/pt-BR/plg_rag_claude.ini</language>
		<language tag="pt-BR">language/pt-BR/plg_rag_claude.sys.ini</language>
		<language tag="pt-PT">language/pt-PT/plg_rag_claude.ini</language>
		<language tag="pt-PT">language/pt-PT/plg_rag_claude.sys.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_rag_claude.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_rag_claude.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="api_key"
					type="password"
					label="PLG_RAG_CLAUDE_FIELD_API_KEY_LABEL"
					description="PLG_RAG_CLAUDE_FIELD_API_KEY_DESC"
					autocomplete="off"
					maxlength="128"
				/>
				<field
					name="model"
					type="list"
					label="PLG_RAG_CLAUDE_FIELD_MODEL_LABEL"
					description="PLG_RAG_CLAUDE_FIELD_MODEL_DESC"
					default="claude-sonnet-5"
				>
					<option value="claude-opus-4-8">Claude Opus 4.8</option>
					<option value="claude-sonnet-5">Claude Sonnet 5</option>
					<option value="claude-haiku-4-5">Claude Haiku 4.5</option>
				</field>
				<field
					name="effort"
					type="list"
					label="PLG_RAG_CLAUDE_FIELD_EFFORT_LABEL"
					description="PLG_RAG_CLAUDE_FIELD_EFFORT_DESC"
					default="low"
					validate="options"
				>
					<option value="low">PLG_RAG_CLAUDE_FIELD_EFFORT_LOW</option>
					<option value="medium">PLG_RAG_CLAUDE_FIELD_EFFORT_MEDIUM</option>
					<option value="high">PLG_RAG_CLAUDE_FIELD_EFFORT_HIGH</option>
				</field>
				<field
					name="timeout"
					type="number"
					label="PLG_RAG_CLAUDE_FIELD_TIMEOUT_LABEL"
					description="PLG_RAG_CLAUDE_FIELD_TIMEOUT_DESC"
					default="300"
					min="10"
					step="1"
					filter="int"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
