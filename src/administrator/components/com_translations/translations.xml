<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_translations</name>
    <creationDate>2026-05-25</creationDate>
    <author>Joomla! Project</author>
    <authorUrl>https://github.com/joomla-projects/gsoc26_translator_feedback</authorUrl>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>4.0.1</version>
    <description>COM_TRANSLATIONS_XML_DESCRIPTION</description>
    <namespace path="src">Joomla\Component\Translations</namespace>
    <scriptfile>script.php</scriptfile>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/install.postgresql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/uninstall.postgresql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>
    <media folder="media/com_translations" destination="com_translations">
        <folder>css</folder>
        <folder>js</folder>
    </media>
    <files folder="components/com_translations">
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <administration>
        <files folder="administrator/components/com_translations">
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>sql</folder>
            <folder>forms</folder>
            <file>config.xml</file>
            <file>access.xml</file>
            <file>translations.xml</file>
            <file>contenttypes.json</file>
        </files>
        <languages folder="administrator/components/com_translations">
            <language tag="en-GB">language/en-GB/com_translations.sys.ini</language>
            <language tag="en-GB">language/en-GB/com_translations.ini</language>
            <language tag="de-DE">language/de-DE/com_translations.sys.ini</language>
            <language tag="de-DE">language/de-DE/com_translations.ini</language>
            <language tag="es-ES">language/es-ES/com_translations.sys.ini</language>
            <language tag="es-ES">language/es-ES/com_translations.ini</language>
            <language tag="fa-IR">language/fa-IR/com_translations.sys.ini</language>
            <language tag="fa-IR">language/fa-IR/com_translations.ini</language>
            <language tag="fr-FR">language/fr-FR/com_translations.sys.ini</language>
            <language tag="fr-FR">language/fr-FR/com_translations.ini</language>
            <language tag="it-IT">language/it-IT/com_translations.sys.ini</language>
            <language tag="it-IT">language/it-IT/com_translations.ini</language>
            <language tag="nl-NL">language/nl-NL/com_translations.sys.ini</language>
            <language tag="nl-NL">language/nl-NL/com_translations.ini</language>
            <language tag="pt-BR">language/pt-BR/com_translations.sys.ini</language>
            <language tag="pt-BR">language/pt-BR/com_translations.ini</language>
            <language tag="pt-PT">language/pt-PT/com_translations.sys.ini</language>
            <language tag="pt-PT">language/pt-PT/com_translations.ini</language>
            <language tag="ru-RU">language/ru-RU/com_translations.sys.ini</language>
            <language tag="ru-RU">language/ru-RU/com_translations.ini</language>
        </languages>
        <menu link="option=com_translations" img="class:translations">COM_TRANSLATIONS</menu>
        <submenu>
            <menu link="option=com_translations&amp;view=queue" img="class:translations">COM_TRANSLATIONS_SUBMENU_QUEUE</menu>
            <menu link="option=com_translations&amp;view=rules" img="class:translations">COM_TRANSLATIONS_SUBMENU_RULES</menu>
        </submenu>
    </administration>
</extension>
